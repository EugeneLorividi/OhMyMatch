# Copy to ~/secrets/ohmymatch.env (outside the repo) and chmod 600.
# Never commit real values.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# postgresql+psycopg://USER:PASSWORD@db:5432/DB
DATABASE_URL=

SECRET_KEY=

# TRUSTED_PROXIES is set in docker-compose.yml (the edge network gateway), not here.

# Key for the optional Telegram @username exchange (a Fernet key). Empty switches the feature
# off. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it out of the database and the backups; changing it makes stored usernames unreadable.
CONTACT_KEY=
