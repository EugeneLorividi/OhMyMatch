# /etc/logrotate.d/ohmymatch (installed by root). Spec section 9: proxy logs at most 7 days.
# Today's file plus 6 rotated days; maxage drops anything older even if rotation was skipped.
/var/log/nginx-ohmymatch/access.log {
    daily
    rotate 6
    maxage 7
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        [ -f /run/nginx.pid ] && kill -USR1 $(cat /run/nginx.pid)
    endscript
}
